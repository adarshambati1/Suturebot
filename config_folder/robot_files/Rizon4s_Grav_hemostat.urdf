<?xml version="1.0"?>
<!-- ======================================================================== -->
<!-- | Flexiv Rizon 4s + Grav, fixed-joint variant.                          | -->
<!-- |                                                                       | -->
<!-- | Identical to Rizon4s_Grav.urdf except every gripper joint is welded   | -->
<!-- | fixed (no <axis>, <limit>, <mimic> tags). The Grav is visible on the | -->
<!-- | arm in its rest pose but is not actuated, which sidesteps Sai's lack | -->
<!-- | of URDF <mimic> support. Use this for scenes that just need the      | -->
<!-- | gripper on the model. For actual grip/ungrip, point the XML at       | -->
<!-- | Rizon4s_Grav.urdf instead and re-add the gripper_fingers jointTask.  | -->
<!-- ======================================================================== -->

<robot name="rizon4s_grav_hemostat">

    <mujoco>
        <compiler meshdir="./" strippath="false" balanceinertia="true" discardvisual="false" fusestatic="true"/>
    </mujoco>

  <!-- base link -->
  <link name="grav_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.057"/>
      <mass value="1.186"/>
      <inertia ixx="3E-3" ixy="0" ixz="0" iyy="3E-3" iyz="0" izz="1E-3"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- left finger links -->
  <link name="left_outer_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="left_inner_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="left_finger_mount">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
  </link>
  <link name="left_finger_tip">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_tip.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/finger_tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- right finger links -->
  <link name="right_outer_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="right_inner_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="right_finger_mount">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
  </link>
  <link name="right_finger_tip">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_tip.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/finger_tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- TCP links -->
  <link name="grav_tcp">
    <!-- open finger, used by RCA -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
  </link>
  <link name="closed_fingers_tcp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
  </link>
  <link name="left_finger_tcp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
  </link>
  <link name="right_finger_tcp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-6"/>
      <inertia ixx="1E-8" ixy="0" ixz="0" iyy="1E-8" iyz="0" izz="1E-8"/>
    </inertial>
  </link>

  <!-- Hemostat (surgical clamp). Mesh STL is ~1760 × 1262 × 49.5 in native
       units; scaled 0.0007 to ~123 × 88 × 3.5 mm. Attached to
       closed_fingers_tcp as a fixed visual + collision; orientation may
       need tweaking once you see how the STL is authored. -->
  <link name="hemostat">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.06"/>
      <mass value="0.05"/>
      <inertia ixx="1E-4" ixy="0" ixz="0" iyy="1E-4" iyz="0" izz="1E-4"/>
    </inertial>
    <visual>
      <origin rpy="0 -1.5708 0" xyz="0.0899 0.0080 -0.0073"/>
      <geometry>
        <mesh filename="SURGERY_CLAMP_ASSY.stl" scale="0.0000711 0.0000711 0.0000711"/>
      </geometry>
      <material name="hemostat_steel">
        <color rgba="0.8 0.8 0.85 1.0"/>
      </material>
    </visual>
    <!-- Collision removed: hemostat is a visual indicator only; it
         shouldn't physically collide with the foam scene. -->

    <!-- (Removed the old imaginary straight needle + red jaws-tip debug ball.
         The real needle is now the curved 'Needle' dynamic_object in the world,
         held via the kinematic-pin grasp transform -- not baked into the arm.) -->

    <!-- (Removed the link X/Y/Z debug axis indicators -- visual clutter.) -->
  </link>

  <!-- JOINTS -->
  <joint name="open_fingers_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
    <parent link="grav_base_link"/>
    <child link="grav_tcp"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="hemostat_joint" type="fixed">
    <origin rpy="0.2 0 0" xyz="0.0035 -0.046 0.175"/>
    <parent link="grav_base_link"/>
    <child link="hemostat"/>
  </joint>
  <joint name="closed_fingers_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.20"/>
    <parent link="grav_base_link"/>
    <child link="closed_fingers_tcp"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- left finger joints (welded fixed) -->
  <joint name="left_outer_knuckle_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0325 0.0825"/>
    <parent link="grav_base_link"/>
    <child link="left_outer_bar"/>
  </joint>
  <joint name="left_inner_knuckle_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0165 0.0995"/>
    <parent link="grav_base_link"/>
    <child link="left_inner_bar"/>
  </joint>
  <joint name="left_inner_finger_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.058"/>
    <parent link="left_outer_bar"/>
    <child link="left_finger_mount"/>
  </joint>
  <joint name="left_inner_finger_pad_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.010 0.0235"/>
    <parent link="left_finger_mount"/>
    <child link="left_finger_tip"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="left_finger_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0135 0.036"/>
    <parent link="left_finger_tip"/>
    <child link="left_finger_tcp"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- right finger joints (welded fixed) -->
  <joint name="right_outer_knuckle_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0.0325 0.0825"/>
    <parent link="grav_base_link"/>
    <child link="right_outer_bar"/>
  </joint>
  <joint name="right_inner_knuckle_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0.0165 0.0995"/>
    <parent link="grav_base_link"/>
    <child link="right_inner_bar"/>
  </joint>
  <joint name="right_inner_finger_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.058"/>
    <parent link="right_outer_bar"/>
    <child link="right_finger_mount"/>
  </joint>
  <joint name="right_inner_finger_pad_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.010 0.0235"/>
    <parent link="right_finger_mount"/>
    <child link="right_finger_tip"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_finger_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0135 0.036"/>
    <parent link="right_finger_tip"/>
    <child link="right_finger_tcp"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- Master control joint (also welded fixed in this variant). -->
  <joint name="finger_width_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="grav_base_link"/>
    <child link="unused_finger_width_link"/>
  </joint>
  <link name="unused_finger_width_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
  </link>
  <!-- Connect the gripper to the robot flange link -->
  <joint name="gripper_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="grav_base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="3.7" />
      <origin rpy="0 0 0" xyz="0.0 -0.0 0.09" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link0.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link0.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link1">
    <inertial>
      <mass value="3.7" />
      <origin rpy="0 0 0" xyz="0.0 0.01 0.15" />
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link1.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.062 0.062 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link1.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link2">
    <inertial>
      <mass value="2.7" />
      <origin rpy="0 0 0" xyz="0.0 0.04 0.1" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="-0.0" izz="0.02" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link2.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.062 0.062 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link2.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link3">
    <inertial>
      <mass value="2.4" />
      <origin rpy="0 0 0" xyz="-0.01 -0.0 0.13" />
      <inertia ixx="0.01" ixy="0.0" ixz="-0.0" iyy="0.01" iyz="-0.0" izz="0.01" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link3.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link3.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link4">
    <inertial>
      <mass value="2.4" />
      <origin rpy="0 0 0" xyz="-0.01 0.03 0.1" />
      <inertia ixx="0.02" ixy="0.0" ixz="-0.0" iyy="0.02" iyz="-0.0" izz="0.02" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link4.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link4.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link5">
    <inertial>
      <mass value="2.4" />
      <origin rpy="0 0 0" xyz="-0.0 0.0 0.13" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link5.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link5.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link6">
    <inertial>
      <mass value="2.1" />
      <origin rpy="0 0 0" xyz="-0.01 0.06 0.07" />
      <inertia ixx="0.01" ixy="-0.0" ixz="-0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link6.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0" />
      <geometry>
