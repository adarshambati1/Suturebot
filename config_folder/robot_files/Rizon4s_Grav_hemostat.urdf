    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link6.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="link7">
    <inertial>
      <mass value="1.4" />
      <origin rpy="0 0 0" xyz="0.0 0.0 0.05" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/visual/link7.obj" />
      </geometry>
      <material name="rizon_light_grey" />
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0" />
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <visual name="camera">
      <origin rpy="1.5717 3.1415 1.5717" xyz="0.045 0 0.046" />
      <geometry>
        <mesh filename="rizon4s/visual/d405-camera-mount.obj" scale="1 1 1" />
      </geometry>
      <material name="rizon_white" />
    </visual>
    <visual name="left-eye">
      <origin rpy="0 0 0" xyz="0.074 -0.01 0.136" />
      <geometry>
        <sphere radius="0.005"/>
      </geometry> 
      <material name="rizon_blue">
        <color rgba="0.0 0.0 1.0 0.5" />
      </material>
    </visual>
    <!-- <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="rizon4s/scollision/link7.stl" />
      </geometry>
    </collision> -->
  </link>
  <link name="flange">
