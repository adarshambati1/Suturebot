<?xml version="1.0" ?>

<!-- Suturing scene (Phase 1 of the running-stitch FSM).

     A solid 1-inch (25.4 mm) foam slab sitting flat on the table, with a slit
     line down the middle (the wound). No risers / no open channel: during the
     drive the needle is kinematic-pinned, so it passes through the foam volume
     regardless of collision (the pin overrides physics); collision only matters
     for a RELEASED needle resting on the surface (the kill-window tip-over).

     Placed in the +X / -Y quadrant and pulled IN toward the base so the
     left-arm Rizon4s works in a comfortable bent-elbow pose (not reaching out
     near a singularity). The support wall sits on the robot-facing (-X) side of
     the pad so the arm can lay the needle against it from its own side.

     Frame: X across the slit, Y along the slit, Z up. Work region centered at
     world (0.45, -0.20). ALL DIMENSIONS / CENTER ARE FIRST-PASS DEFAULTS. -->

<world name="suture_pad_world" gravity="0.0 0.0 -9.81">

	<robot name="Rizon4s">
		<model dir="${ROBOT_FILES_FOLDER}" path="Rizon4s_Grav_hemostat.urdf" name="Rizon4s" />
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 -0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="5.0 5.0 0.1" /></geometry>
			<material name="material_floor"><color rgba="0.15 0.15 0.18 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="5.0 5.0 0.1" /></geometry>
		</collision>
	</static_object>

	<!-- Foam pad: solid 1-inch slab, 100 (X) x 120 (Y) mm footprint, bottom on
	     the table (z=0), top at z=0.0254. Slit runs along Y at X=0.45. -->
	<static_object name="FoamPad">
		<origin xyz="0.450 -0.200 0.0127" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="0.100 0.120 0.0254" /></geometry>
			<material name="material_foam"><color rgba="0.95 0.85 0.75 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="0.100 0.120 0.0254" /></geometry>
		</collision>
	</static_object>

	<!-- Slit marker: thin red line on the pad top marking the wound (X=0.45,
	     along Y). Visual only; the vision phase keys off this. -->
	<static_object name="SlitMarker">
		<origin xyz="0.450 -0.200 0.02551" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="0.0008 0.120 0.0002" /></geometry>
			<material name="material_slit"><color rgba="0.8 0.1 0.1 1.0" /></material>
		</visual>
	</static_object>

	<!-- Kill-window support wall. Whole wound assembly rotated 180 deg about Z
	     at the work center (0.45, -0.20): the wall is now just off the FAR (+X)
	     edge of the pad, parallel to the slit. (The pad + slit are symmetric so
	     they look unchanged; only the wall side flips.) Placement is a Phase-4
	     tuning target. -->
	<static_object name="SupportBlock">
		<origin xyz="0.506 -0.200 0.015" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="0.012 0.120 0.030" /></geometry>
			<material name="material_block"><color rgba="0.85 0.80 0.70 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry><box size="0.012 0.120 0.030" /></geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisX">
		<origin xyz="0.05 0.0 0.0" rpy="0 1.5708 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.003" length="0.10" /></geometry><material name="world_axis_x"><color rgba="1.0 0.0 0.0 1.0" /></material></visual>
	</static_object>
	<static_object name="WorldAxisY">
		<origin xyz="0.0 0.05 0.0" rpy="-1.5708 0 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.003" length="0.10" /></geometry><material name="world_axis_y"><color rgba="0.0 1.0 0.0 1.0" /></material></visual>
	</static_object>
	<static_object name="WorldAxisZ">
		<origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><cylinder radius="0.003" length="0.10" /></geometry><material name="world_axis_z"><color rgba="0.0 0.0 1.0 1.0" /></material></visual>
	</static_object>

	<!-- NEEDLE_START (generated by scripts/gen_needle_urdf.py - do not hand-edit) -->
	<dynamic_object name="Needle">
		<origin xyz="0.45000 -0.20000 0.10000" rpy="0.0 0.0 0.0" />
		<inertial>
			<origin xyz="0.00161 0.00389 0" rpy="0 0 0" />
			<mass value="0.05" />
			<inertia ixx="6.050e-06" iyy="6.050e-06" izz="6.050e-06" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual><origin xyz="0.01081 0.00142 0.00000" rpy="0.00000 1.57080 1.70170" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="0.01008 0.00417 0.00000" rpy="0.00000 1.57080 1.96350" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="0.00865 0.00664 0.00000" rpy="0.00000 1.57080 2.22529" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="0.00664 0.00865 0.00000" rpy="0.00000 1.57080 2.48709" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="0.00417 0.01008 0.00000" rpy="0.00000 1.57080 2.74889" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="0.00142 0.01081 0.00000" rpy="0.00000 1.57080 3.01069" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="-0.00142 0.01081 0.00000" rpy="0.00000 1.57080 3.27249" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="-0.00417 0.01008 0.00000" rpy="0.00000 1.57080 3.53429" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="-0.00664 0.00865 0.00000" rpy="0.00000 1.57080 3.79609" /><geometry><cylinder radius="0.00080" length="0.00287" /></geometry><material name="needle_steel"><color rgba="0.75 0.78 0.82 1.0" /></material></visual>
		<visual><origin xyz="-0.00778 0.00778 0.00000" rpy="0 0 0" /><geometry><sphere radius="0.00112" /></geometry><material name="needle_tip"><color rgba="0.85 0.15 0.15 1.0" /></material></visual>
		<visual><origin xyz="0.01100 0.00000 0.00000" rpy="0 0 0" /><geometry><box size="0.00090 0.00400 0.00220" /></geometry><material name="needle_flat"><color rgba="0.20 0.55 0.90 1.0" /></material></visual>
		<collision><origin xyz="0.00161 0.00389 0.00000" rpy="0 0 2.74889" /><geometry><box size="0.02033 0.00240 0.00240" /></geometry></collision>
	</dynamic_object>
	<!-- NEEDLE_END -->

	<light name="light_front" type="directional">
		<position xyz="1.8 -2.0 2.0" />
		<lookat xyz="0.45 -0.20 0.02" />
	</light>

	<!-- 3/4 view of the wound from the robot/-Y side. -->
	<camera name="camera_fixed">
		<position xyz="0.15 -0.45 0.20" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.45 -0.20 0.02" />
	</camera>

</world>
