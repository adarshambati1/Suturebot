<?xml version="1.0" ?>

<!-- Suturebot simulation world (Grav variant).
     Rizon4s + welded-fixed Grav gripper, foam base + foam block scene.
     The gripper is visible on the flange but all its joints are welded
     fixed (Sai doesn't honor URDF <mimic>). -->

<world name="suturebot_grav_world" gravity="0.0 0.0 -9.81">

	<robot name="Rizon4s">
		<model dir="${ROBOT_FILES_FOLDER}" path="Rizon4s_Grav_hemostat.urdf" name="Rizon4s" />
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 -0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
			<material name="material_floor">
				<color rgba="0.15 0.15 0.18 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
		</collision>
	</static_object>

	<!-- FoamBase: 65 (Y) x 8 (Z) x 130 (X) mm slab, with two 5 (Y) x
	     15 (Z) x 130 (X) mm walls sitting on top running the length.
	     Walls have a 5.7 mm gap between their inner faces. Wall outer
	     faces sit 24.7 mm in from each end of the slab in Y. Centered
	     at world (0.55, 0, *) with the slab bottom on the floor. -->
	<static_object name="FoamBaseSlab">
		<origin xyz="0.55 0.0 0.004" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.065 0.008" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.065 0.008" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallLeft">
		<origin xyz="0.55 -0.00535 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.005 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.005 0.015" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallRight">
		<origin xyz="0.55 0.00535 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.005 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.005 0.015" />
			</geometry>
		</collision>
	</static_object>

	<!-- FoamBlock: 130 mm long (X), 5.7 mm thick (Y) to fit between the
	     two walls, 22.5 mm tall (Z). Bottom on slab at z=0.008; top
	     extends 7.5 mm above the wall tops (walls top at z=0.023, foam
	     top at z=0.0305). -->
	<static_object name="FoamBlock">
		<origin xyz="0.55 0.0 0.01925" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.0057 0.0225" />
			</geometry>
			<material name="material_foam">
				<color rgba="0.95 0.85 0.75 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.130 0.0057 0.0225" />
			</geometry>
		</collision>
	</static_object>

	<!-- World axis indicators (red X, green Y, blue Z), 10 cm each at origin. -->
	<static_object name="WorldAxisX">
		<origin xyz="0.05 0.0 0.0" rpy="0 1.5708 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_x"><color rgba="1.0 0.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisY">
		<origin xyz="0.0 0.05 0.0" rpy="-1.5708 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_y"><color rgba="0.0 1.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisZ">
		<origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_z"><color rgba="0.0 0.0 1.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<light name="light_front" type="directional">
		<position xyz="2.0 -2.0 2.0" />
		<lookat xyz="0.55 0.0 0.04" />
	</light>

	<light name="light_back" type="directional">
		<position xyz="-1.0 2.0 2.0" />
		<lookat xyz="0.55 0.0 0.04" />
	</light>

	<!-- Side view from world +X looking back at the foam. The Y-axis
	     puncture motion reads as a left-to-right sweep across the camera. -->
	<camera name="camera_fixed">
		<position xyz="1.0 0.0 0.15" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.55 0.0 0.04" />
	</camera>

</world>
