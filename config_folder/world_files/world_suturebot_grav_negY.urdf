<?xml version="1.0" ?>

<!-- Suturebot simulation world — scene rotated -90 deg about world +Z
     relative to world_suturebot_grav.urdf. Robot base is NOT rotated;
     it stays at origin facing +X. Foam center moves from (0.55, 0, ...)
     to (0, -0.55, ...), with the foam's long axis now along world Y. -->

<world name="suturebot_grav_negY_world" gravity="0.0 0.0 -9.81">

	<robot name="Rizon4s">
		<model dir="${ROBOT_FILES_FOLDER}" path="Rizon4s_Grav_hemostat.urdf" name="Rizon4s" />
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 -0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
			<material name="material_floor">
				<color rgba="0.15 0.15 0.18 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
		</collision>
	</static_object>

	<!-- Foam rotated -90 about world +Z. Long axis along world Y, thin
	     axis along world X. Centered at (0, -0.55, ...). -->
	<static_object name="FoamBaseSlab">
		<origin xyz="0.0 -0.55 0.004" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.065 0.130 0.008" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.065 0.130 0.008" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallLeft">
		<origin xyz="-0.00535 -0.55 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallRight">
		<origin xyz="0.00535 -0.55 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBlock">
		<origin xyz="0.0 -0.55 0.01925" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.0057 0.130 0.0225" />
			</geometry>
			<material name="material_foam">
				<color rgba="0.95 0.85 0.75 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.0057 0.130 0.0225" />
			</geometry>
		</collision>
	</static_object>

	<!-- World axis indicators (red X, green Y, blue Z), 10 cm each at origin.
	     These represent the world frame and stay aligned with the world axes. -->
	<static_object name="WorldAxisX">
		<origin xyz="0.05 0.0 0.0" rpy="0 1.5708 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_x"><color rgba="1.0 0.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisY">
		<origin xyz="0.0 0.05 0.0" rpy="-1.5708 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_y"><color rgba="0.0 1.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisZ">
		<origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_z"><color rgba="0.0 0.0 1.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<light name="light_front" type="directional">
		<position xyz="-2.0 -2.0 2.0" />
		<lookat xyz="0.0 -0.55 0.04" />
	</light>

	<light name="light_back" type="directional">
		<position xyz="2.0 1.0 2.0" />
		<lookat xyz="0.0 -0.55 0.04" />
	</light>

	<!-- Camera rotated with the scene: now on world -Y side looking back
	     toward the foam at (0, -0.55, ...). The +X pierce direction reads
	     as a horizontal sweep on screen. -->
	<camera name="camera_fixed">
		<position xyz="0.0 -1.0 0.15" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.0 -0.55 0.04" />
	</camera>

</world>
