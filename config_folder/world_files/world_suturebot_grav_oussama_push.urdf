<?xml version="1.0" ?>

<!-- Suturebot simulation world - Grav variant, "Oussama Push".
     Same scene as world_suturebot_grav.urdf but the foam slab, walls,
     and block are rotated 90° about world Z at the foam center
     (from +X toward +Y). The slot now runs along world Y; the foam
     is thin (5.7 mm) along world X. Pierce direction is world -X. -->

<world name="suturebot_grav_oussama_push_world" gravity="0.0 0.0 -9.81">

	<robot name="Rizon4s">
		<model dir="${ROBOT_FILES_FOLDER}" path="Rizon4s_Grav_hemostat.urdf" name="Rizon4s" />
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 -0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
			<material name="material_floor">
				<color rgba="0.15 0.15 0.18 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="5.0 5.0 0.1" />
			</geometry>
		</collision>
	</static_object>

	<!-- After 90° rotation about Z at (0.738, 0):
	     - Slab: 130 (Y) x 65 (X) x 8 (Z) mm (long axis was X, now Y)
	     - Walls: 130 (Y) x 5 (X) x 15 (Z) mm, 5.7 mm gap in X between
	       their inner faces. Wall outer faces sit 24.7 mm in from each
	       end of the slab in Y.
	     - WallLeft (was -Y of slot) is now at +X side of slot.
	     - WallRight (was +Y of slot) is now at -X side of slot.
	     Centered at world (0.738, 0, *) with the slab bottom on the
	     floor. Moved outward from the original (0.55, 0) so the clamp
	     at home sits 66 cm from the base. -->
	<static_object name="FoamBaseSlab">
		<origin xyz="0.738 0.0 0.004" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.065 0.130 0.008" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.065 0.130 0.008" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallLeft">
		<origin xyz="0.74335 0.0 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="FoamBaseWallRight">
		<origin xyz="0.73265 0.0 0.0155" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
			<material name="material_base">
				<color rgba="0.30 0.30 0.34 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.005 0.130 0.015" />
			</geometry>
		</collision>
	</static_object>

	<!-- FoamBlock: 5.7 mm thick (X) to fit between the two walls,
	     130 mm long (Y), 22.5 mm tall (Z). Bottom on slab at z=0.008;
	     top extends 7.5 mm above the wall tops (walls top at z=0.023,
	     foam top at z=0.0305). -->
	<static_object name="FoamBlock">
		<origin xyz="0.738 0.0 0.01925" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.0057 0.130 0.0225" />
			</geometry>
			<material name="material_foam">
				<color rgba="0.95 0.85 0.75 1.0" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.0057 0.130 0.0225" />
			</geometry>
		</collision>
	</static_object>

	<!-- World axis indicators (red X, green Y, blue Z), 10 cm each at origin. -->
	<static_object name="WorldAxisX">
		<origin xyz="0.05 0.0 0.0" rpy="0 1.5708 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_x"><color rgba="1.0 0.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisY">
		<origin xyz="0.0 0.05 0.0" rpy="-1.5708 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_y"><color rgba="0.0 1.0 0.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<static_object name="WorldAxisZ">
		<origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
			<material name="world_axis_z"><color rgba="0.0 0.0 1.0 1.0" /></material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.003" length="0.10" />
			</geometry>
		</collision>
	</static_object>

	<light name="light_front" type="directional">
		<position xyz="2.0 -2.0 2.0" />
		<lookat xyz="0.738 0.0 0.04" />
	</light>

	<light name="light_back" type="directional">
		<position xyz="-1.0 2.0 2.0" />
		<lookat xyz="0.738 0.0 0.04" />
	</light>

	<!-- Side view from world +Y looking back at the foam. The X-axis
	     puncture motion reads as a left-to-right sweep across the camera. -->
	<camera name="camera_fixed">
		<position xyz="0.738 1.0 0.15" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.738 0.0 0.04" />
	</camera>

</world>
