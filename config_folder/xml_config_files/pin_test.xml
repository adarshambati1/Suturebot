<redisConfiguration namespacePrefix="opensai" />

<simvizConfiguration
	worldFilePath="${WORLD_FILES_FOLDER}/world_pin_test.urdf">

	<simParameters frictionCoefficient="1.0"
		collisionRestitutionCoefficient="0.1" />

	<logger logFolderName="log_files/pin_test/simviz"
		enabledAtStartup="false"
		addTimestampToFilename="false" />
</simvizConfiguration>

<!-- getMassMatrixFromRedis=false: same welded-gripper non-SPD workaround as
     the other suturebot configs. The robot just holds position; the test
     only exercises the TestBox dynamic object. -->
<robotControlConfiguration robotName="Rizon4s"
	robotModelFile="${ROBOT_FILES_FOLDER}/Rizon4s_Grav_hemostat.urdf"
	getMassMatrixFromRedis="false">

	<logger logFolderName="log_files/pin_test/controllers"
		enabledAtStartup="false"
		addTimestampToFilename="false" />

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task" linkName="flange">
			<velocitySaturation enabled="false" />
			<otg type="acceleration"
				maxLinearVelocity="0.1"
				maxAngularVelocity="1.0"
				maxLinearAcceleration="1.5"
				maxLinearJerk="5.0"
				maxAngularAcceleration="3.0"
				maxAngularJerk="100"/>
			<positionGains kp="400.0" kv="40.0" />
			<orientationGains kp="400.0" kv="40.0" />
		</motionForceTask>
		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>
