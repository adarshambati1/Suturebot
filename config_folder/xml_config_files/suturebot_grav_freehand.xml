<redisConfiguration namespacePrefix="opensai" />

<!-- Free-float TEACHING variant of suturebot_grav_real.xml.
     Same real-robot setup (no simvizConfiguration; state comes from the Flexiv
     driver under "Titania"). The active controller is a pure gravity-comp
     "floating" task: a joint task at ZERO gains. With gravityCompensation off
     OpenSai sends near-zero torque; with it on OpenSai also compensates gravity.
     Joint state still publishes to opensai::sensors::Titania::joint_positions
     regardless of the active controller, so record_demo_redis.py can capture a
     hand-guided trajectory.
     "floating" is listed first so it is active at launch; the cartesian / joint
     controllers are kept so you can switch back over Redis
     (opensai::controllers::Titania::active_controller_name) without relaunching. -->

<robotControlConfiguration robotName="Titania"
	robotModelFile="${ROBOT_FILES_FOLDER}/Rizon4s_Grav_hemostat.urdf"
	getMassMatrixFromRedis="false">

	<logger logFolderName="log_files/suturebot_grav_freehand/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<!-- Free-float: zero joint gains, gravity comp OFF. The Flexiv driver
	     already compensates gravity (turning OpenSai comp on as well drove the
	     arm upward), so OpenSai contributes near-zero torque here. If the arm
	     SAGS on launch instead, the driver is not comping: set
	     gravityCompensation="true". -->
	<controller name="floating" gravityCompensation="false">
		<jointTask name="joint_task">
			<jointGains kp="0.0" kv="0.0" ki="0.0" />
			<velocitySaturation enabled="false" />
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task"
			linkName="flange">
			<velocitySaturation enabled="false" />
			<otg type="disabled" />
			<positionGains kp="400.0" kv="40.0" />
			<orientationGains kp="400.0" kv="40.0" />
		</motionForceTask>

		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>
