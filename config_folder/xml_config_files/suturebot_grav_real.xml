<redisConfiguration namespacePrefix="opensai" />

<!-- Real-robot variant: no <simvizConfiguration> block.
     Robot state comes from the Flexiv driver (titania-4a) publishing
     to Redis under the "Titania" namespace; OpenSai_main just runs
     the controller. -->

<!-- getMassMatrixFromRedis=false: with the welded-fixed gripper, the
     simulator's mass-matrix computation produced a non-SPD M (the
     cause of the earlier "M is not symmetric positive definite"
     crash). Forcing the controller to compute M from the model
     sidesteps that. -->
<robotControlConfiguration robotName="Titania"
	robotModelFile="${ROBOT_FILES_FOLDER}/Rizon4s_Grav_hemostat.urdf"
	getMassMatrixFromRedis="false">

	<logger logFolderName="log_files/suturebot_grav_real/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<!-- Cartesian task on the flange (the gripper attachment point).
	     The Grav extends ~20 cm below the flange in flange-Z. Combined
	     with the mosquito forceps + 69.81 mm needle, the chain to the
	     needle tip is ~30 cm below the flange. -->
	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task"
			linkName="flange">
			<velocitySaturation enabled="false" />

			<otg type="acceleration"
				maxLinearVelocity="0.1"
				maxAngularVelocity="1.0"
				maxLinearAcceleration="1.5"
				maxLinearJerk="5.0"
				maxAngularAcceleration="3.0"
				maxAngularJerk="100"/>

			<positionGains kp="400.0" kv="40.0" />
			<orientationGains kp="400.0" kv="40.0" />
		</motionForceTask>

		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>
